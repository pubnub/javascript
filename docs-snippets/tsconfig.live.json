{
  "//": "Live docs snippet suite. Used by tsx at run time (TSX_TSCONFIG_PATH) and by tsc (npm run test:docs-snippets:types). The first pubnub candidate is the built SDK that tsx loads, tsc skips it (no allowJs) and takes the shipped types.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "mocha"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "pubnub": ["../lib/types/index.d.ts", "../lib/node/index.js"]
    }
  },
  "include": [
    "run.ts",
    "harness/**/*.ts",
    "fixtures/**/*.ts",
    "provision/**/*.ts",
    "shared/**/*.ts",
    "api-reference/**/*.ts",
    "getting-started/**/*.ts",
    "migration-guides/**/*.ts"
  ],
  "exclude": ["node_modules", ".run", "report"]
}
