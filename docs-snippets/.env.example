# Keys for the live docs snippet tests (docs-snippets/README.md, "Use your own keys").
# Copy this file to docs-snippets/.env.local and fill in the values. Git ignores .env.local.
# Real environment variables win over this file. Leave a role empty to skip its steps (missing-env:<role>).

# open: a keyset without Access Manager
SUBSCRIBE_KEY=
PUBLISH_KEY=

# pam: a keyset with Access Manager and token revocation
PAM_SUBSCRIBE_KEY=
PAM_PUBLISH_KEY=
PAM_SECRET_KEY=

# datasync: a keyset with Access Manager and DataSync. It may be the same keyset as pam.
DS_SUBSCRIBE_KEY=
DS_PUBLISH_KEY=
DS_SECRET_KEY=

# Optional. A Service Integration key with DataSync read and write on the datasync keyset. It creates the DataSync classes.
PUBNUB_ADMIN_API_KEY=

# Optional, not secret. Admin Portal keyset ids, so the preflight can read each keyset's features through the Admin API.
DOCS_SNIPPETS_OPEN_KEYSET_ID=
DOCS_SNIPPETS_PAM_KEYSET_ID=
DOCS_SNIPPETS_DS_KEYSET_ID=
