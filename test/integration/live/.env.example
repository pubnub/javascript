# Keys for the live tier (test/integration/live/README.md). Copy to test/integration/live/.env.local, which git ignores.
# Real environment variables win over the file. LIVE_ENV_FILE=<path> points at another file.

# open: a keyset without Access Manager
SUBSCRIBE_KEY=
PUBLISH_KEY=

# pam: a keyset with Access Manager
PAM_SUBSCRIBE_KEY=
PAM_PUBLISH_KEY=
PAM_SECRET_KEY=

# datasync: a keyset with Access Manager and DataSync (may be the same as pam)
DS_SUBSCRIBE_KEY=
DS_PUBLISH_KEY=
DS_SECRET_KEY=
